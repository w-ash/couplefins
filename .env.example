# Database (Neon PostgreSQL)
DATABASE__URL=postgresql+asyncpg://user:pass@ep-xxxx.us-west-2.aws.neon.tech/dbname?sslmode=require
DATABASE__ECHO=false

# Test database — integration tests TRUNCATE all tables on teardown.
# NEVER point this at production. The default below targets the local
# Postgres 18 container in docker-compose.yml; start it with `docker compose up -d`.
# If unset, integration tests are skipped.
TEST_DATABASE__URL=postgresql+asyncpg://couplefins:couplefins@localhost:5433/couplefins_test

# Logging
LOGGING__OUTPUT=console
LOGGING__LEVEL=INFO
# Optional rotating file sink. Unset means stdout only, which is what the
# deployed container uses. Set it locally to keep a JSON log on disk.
LOGGING__FILE_PATH=logs/couplefins.log

# Auth — the default JWT secret is a public placeholder. Production must set
# its own (>=32 bytes) and turn on the Secure cookie flag over HTTPS.
# AUTH__JWT_SECRET=
# AUTH__COOKIE_SECURE=false

# Chat assistant. Unset means chat is unavailable and the rest of the app is
# unaffected.
# CHAT__ANTHROPIC_API_KEY=
