# Database (Neon PostgreSQL)
DATABASE__URL=postgresql+asyncpg://user:pass@ep-xxxx.us-west-2.aws.neon.tech/dbname?sslmode=require
DATABASE__ECHO=false

# Test database — integration tests TRUNCATE all tables on teardown.
# NEVER point this at production. Use a Neon test branch or local database.
# If unset, integration tests are skipped.
# TEST_DATABASE__URL=postgresql+asyncpg://user:pass@ep-xxxx.us-west-2.aws.neon.tech/testdb?sslmode=require

# Logging
LOGGING__OUTPUT=console
LOGGING__LEVEL=INFO
