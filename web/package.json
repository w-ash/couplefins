{
  "name": "web",
  "private": true,
  "version": "0.10.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "cd .. && uv run uvicorn src.interface.api.app:app --reload --port 8001 --reload-dir src",
    "start": "concurrently -n api,web -c blue,green \"pnpm api\" \"pnpm dev\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check src/ && tsc --noEmit && vite build",
    "format": "biome check --write src/",
    "pregenerate": "cd .. && uv run python scripts/export_openapi.py",
    "generate": "orval",
    "screenshots": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@faker-js/faker": "^10.3.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "jsdom": "^28.1.0",
    "msw": "^2.12.10",
    "orval": "^8.5.3",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.1",
    "recharts": "^3.8.0",
    "zustand": "^5.0.11"
  }
}
